    public partial class UIActvFlashSale
    {
        [UINodeDescribe(exportSourceType: typeof(UIActvFlashSale), path: "Content/Grid/Item1")]
        private partial class FlashSaleShelfItem
        {
            // AssetPath = "FlashSale/Content/Grid/Item1"
            // 货架格 Item1..Item9 层级相同（BoxNormal/BoxSoldOut/BoxClose/Limit/Remain），共用此绑定；
            // 由 UIActvFlashSale.OnLoad 包装现有静态节点构造（非模板克隆）

            public FlashSaleShelfItem( )
            {
            }

            public FlashSaleShelfItem(GameObject go)
            {
                GameObject = go;
            }

            #region Property


            public GameObject GoBoxNormal => mGoBoxNormal;


            public TFWText TFWTextRemainNum => mTFWTextRemainNum;


            #endregion

            private void OnAutoLoad()
            {

                mGoBoxNormal = mGo.FindByFullPath("BoxNormal");

                mGoBoxSoldOut = mGo.FindByFullPath("BoxSoldOut");

                mGoBoxClose = mGo.FindByFullPath("BoxClose");

                mGoRemain = mGo.FindByFullPath("Remain");

                mGoLimit = mGo.FindByFullPath("Limit");


                mTFWImageIcon = mGo.GetComponent<TFWImage>("BoxNormal/Card/Icon");

                mTFWTextValue = mGo.GetComponent<TFWText>("BoxNormal/Card/Value");

                mTFWTextLimit = mGo.GetComponent<TFWText>("Limit/Text");

                mTFWTextRemainNum = mGo.GetComponent<TFWText>("Remain/Num");

                // 嵌套购买钮（button_Payment 实例，实例名 "Price"，X2 原版每格下方黄色钮）：
                // Layout/txt = 格上大字价格（X2 占位 "9999" 所在节点）；txt_price/txt_get = 源 prefab 自带占位（OnLoad 清空）
                mTFWTextBuyBtnPrice = mGo.GetComponent<TFWText>("BoxNormal/Price/Layout/txt");
                mTFWTextBuyBtnSmallPrice = mGo.GetComponent<TFWText>("BoxNormal/Price/txt_price");
                mTFWTextBuyBtnGet = mGo.GetComponent<TFWText>("BoxNormal/Price/txt_get");
                // X2 内容气泡（默认显"0"），X3 不用，OnLoad 常隐
                mGoContBubble = mGo.FindByFullPath("BoxNormal/ContBubble");


                // 整格点击 = 阶段3内容预览占位（不发 BuyReq，策划评审拍板 07-28）；购买唯一入口 = 嵌套黄钮
                UIHelper.AddListener(EventTriggerType.Click, mGo, "BoxNormal", OnBoxNormalTrigger, out mBtnBoxNormal);

                // 嵌套购买钮自带 Button 组件会吞掉点击（不冒泡到 BoxNormal 的监听），必须单独挂
                UIHelper.AddListener(EventTriggerType.Click, mGo, "BoxNormal/Price", OnBtnBuyTrigger, out mBtnBuyPrice);


            }
            #region Field

            private GameObject mGoBoxNormal;
            private GameObject mGoBoxSoldOut;
            private GameObject mGoBoxClose;
            private GameObject mGoRemain;
            private GameObject mGoLimit;

            private TFWImage mTFWImageIcon;
            private TFWText mTFWTextValue;
            private TFWText mTFWTextLimit;
            private TFWText mTFWTextRemainNum;
            private TFWText mTFWTextBuyBtnPrice;
            private TFWText mTFWTextBuyBtnSmallPrice;
            private TFWText mTFWTextBuyBtnGet;
            private GameObject mGoContBubble;

            private GameObject mBtnBoxNormal;
            private GameObject mBtnBuyPrice;

            #endregion
